<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 模块自身声明，便于设置页做权限自检；真正加悬浮窗是在被 Hook 的录屏进程里 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Shizuku 模式：向 Shizuku 申请 shell 身份（读触摸屏设备节点用） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- 前台服务：退出界面后保持特效常驻（否则 ColorOS 几秒就回收进程） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ============ Shizuku 通道 ============ -->
        <!-- provider 库只提供类，声明必须由 App 自己写，否则 Shizuku 的 binder
             永远收不到（Shizuku.pingBinder() 恒为 false）。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- ============ LSPosed 模块声明 ============ -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_desc" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <!-- 推荐作用域：录屏 App + 系统框架（系统框架用于拿全局触摸坐标，详见 README） -->
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 常驻服务：Shizuku 模式开启时保活，保证退出界面后特效仍然工作 -->
        <service
            android:name=".core.FxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_screen_click_effect_for_screen_recording" />
        </service>

        <!-- 配置共享：被 Hook 进程通过 ContentResolver.call() 读取 -->
        <!-- 不加 android:permission：system_server / 录屏进程需要能直接 call 到它 -->
        <provider
            android:name=".core.ConfigProvider"
            android:authorities="com.myclick.config"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- 被 Hook 进程索要配置的显式广播接收器（ContentProvider 受包可见性限制时的主通道） -->
        <receiver
            android:name=".core.ConfigRequestReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.myclick.action.CONFIG_REQUEST" />
            </intent-filter>
        </receiver>

        <!-- 「全局生效」静态入口：默认禁用，设置页打开开关时才启用。
             禁用时系统直接丢弃框架的显式广播，不会为了日常点击唤醒模块进程。 -->
        <receiver
            android:name=".core.GlobalTouchReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="com.myclick.action.GLOBAL_TOUCH" />
            </intent-filter>
        </receiver>

        <!-- 开机后把最新配置推送给 system_server（system_server 里访问 ContentProvider 不一定可用） -->
        <receiver
            android:name=".core.BootPushReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
